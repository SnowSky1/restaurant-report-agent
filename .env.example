# ============================================================
# 配置模板 —— 复制为 .env 并填入你自己的真实值（.env 不会被提交）
#   cp .env.example .env
# ============================================================

# LLM provider: qwen | openai | deepseek | siliconflow
LLM_PROVIDER=qwen

# 通义千问 (Qwen) @ DashScope 兼容模式
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 高德地图 API Key
AMAP_MAPS_API_KEY=your_amap_api_key_here

# MCP Server URLs（modelscope 托管的高德 / AntV 图表 MCP）
AMAP_MCP_URL=https://mcp.modelscope.cn/sse/@amap/amap-maps
CHART_MCP_URL=https://mcp.modelscope.cn/sse/@antvis/mcp-server-chart

# 输出目录
OUTPUT_DIR=./reports

# CORS 允许的前端来源（逗号分隔），生产环境改成你的真实域名
ALLOWED_ORIGINS=http://localhost:3000
