# ============================================================
# 配置模板 —— 复制为 .env 并填入你自己的真实值（.env 不会被提交）
#   cp .env.example .env
# ============================================================

# LLM provider: qwen | openai | deepseek | siliconflow
LLM_PROVIDER=qwen

# 通义千问 (Qwen) @ DashScope 兼容模式
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0

# 高德地图 API Key
AMAP_MAPS_API_KEY=your_amap_api_key_here

# real: 任一真实调用失败即报错；auto: 真实优先并明确标注回退；mock: 全模拟
DATA_MODE=auto
AMAP_TRANSPORT=rest
REQUEST_TIMEOUT_SECONDS=15
AMAP_CACHE_TTL_SECONDS=300
AMAP_MAX_RETRIES=2
AMAP_MAX_PARALLEL_REQUESTS=4

# MCP Server URL（可选的高德传输）
AMAP_MCP_URL=https://mcp.modelscope.cn/sse/@amap/amap-maps

# 输出目录
OUTPUT_DIR=./reports
SAVE_API_REPORTS=false
REPORT_RETENTION_DAYS=30

# CORS 允许的前端来源（逗号分隔），生产环境改成你的真实域名
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API 治理；访问令牌留空表示仅依赖网络边界，公开部署时必须设置
API_ACCESS_TOKEN=
API_RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_ANALYSES=2
COMPARE_MAX_PARALLEL_CANDIDATES=2
ANALYSIS_TIMEOUT_SECONDS=180
LOG_LEVEL=INFO
